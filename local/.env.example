# Source this file (`set -a && source local/.env && set +a`, or use direnv)
# before running `terragrunt`/`terraform`/`aws` against the local Floci
# stack. Copy to `local/.env` first — that file is gitignored, this
# `.example` is the template.
#
# These are the AWS SDK's own standard environment variables — the same
# ones the `hashicorp/aws` Terraform provider reads. Nothing in
# terraform/ or terragrunt/ was changed to make this work: unset these
# vars (a fresh shell, or `unset AWS_ENDPOINT_URL`) and every unit goes
# back to talking to real AWS, exactly as before. See local/README.md.

AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1

# AWS_ACCESS_KEY_ID: a 12-digit value — Floci's multi-account isolation
# uses it directly as the account ID (see local/README.md and Floci's
# multi-account docs). Deliberately NOT a real AWS access key, and
# deliberately a different value than the project's one real AWS account
# (184086410155) so the two are never confusable in a shell history or a
# pasted command. Must match terragrunt/_accounts/floci-local/account.hcl's
# account_id exactly, or root.hcl's generated allowed_account_ids guard
# rejects every plan/apply against Floci — see local/README.md, "Wiring
# Terragrunt to this stack".
#
# AWS_SECRET_ACCESS_KEY: Floci accepts any non-empty value.
AWS_ACCESS_KEY_ID=111111111111
AWS_SECRET_ACCESS_KEY=test
